generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  published   Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String         @default("")
  price        Decimal        @db.Decimal(10, 2)
  comparePrice Decimal?       @db.Decimal(10, 2)
  sku          String?
  stock        Int            @default(0)
  published    Boolean        @default(true)
  featured     Boolean        @default(false)
  // Princeton-Tec-style spec badges shown on product cards
  specs        Json           @default("[]")
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  options      ProductOption[]
  variants     Variant[]
  orderItems   OrderItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// e.g. name: "Color", values: ["Black", "Tan", "MultiCam"]
model ProductOption {
  id        String   @id @default(cuid())
  name      String
  values    String[]
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// A purchasable combination of option values, e.g. {"Color":"Black","Size":"M"}
model Variant {
  id         String      @id @default(cuid())
  title      String
  options    Json        @default("{}")
  price      Decimal?    @db.Decimal(10, 2)
  sku        String?
  stock      Int         @default(0)
  image      String?
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Order {
  id         String      @id @default(cuid())
  number     Int         @unique @default(autoincrement())
  customer   String?
  phone      String?
  status     OrderStatus @default(PENDING)
  total      Decimal     @db.Decimal(10, 2)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)

  @@index([orderId])
}

model Image {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())
}

model Settings {
  id             Int     @id @default(1)
  storeName      String  @default("Kohpema Gear")
  whatsappNumber String  @default("")
  announcement   String  @default("FREE Shipping over Rs 25,000")
  currency       String  @default("PKR")
}
